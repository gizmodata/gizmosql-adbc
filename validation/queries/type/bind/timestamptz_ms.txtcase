// Modified by GizmoData LLC: expected results for GizmoSQL (DuckDB), derived
// from the base case by converting to microsecond precision.

// part: metadata

[setup]
drop = "test_timestamptz"

[tags]
sql-type-name = "TIMESTAMP(3) WITH TIME ZONE"
caveats = ["DuckDB stores TIMESTAMP WITH TIME ZONE at microsecond precision; values come back as timestamp[us, UTC] and sub-microsecond digits are truncated."]

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "tsu:UTC",
            "flags": [
                "nullable"
            ]
        },
        {
            "name": "res2",
            "format": "tsu:UTC",
            "flags": [
                "nullable"
            ]
        }
    ]
}

// part: expected

{"res": null, "res2": null}
{"res": -14182940000000, "res2": -14182940000000}
{"res": 946684800000000, "res2": 946684800000000}
{"res": 1684158330000000, "res2": 1684158330000000}
{"res": 253402300799999000, "res2": 253402300799999000}
