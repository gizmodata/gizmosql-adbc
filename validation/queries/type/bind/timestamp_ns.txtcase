// Modified by GizmoData LLC: GizmoSQL server bug, expected results unchanged.

// part: metadata

[setup]
drop = "test_timestamp"

[tags]
sql-type-name = "TIMESTAMP(9)"
broken-vendor = "DuckDB reserves the extreme nanosecond timestamps (it cannot store -2^63 ns), and GizmoSQL v1.42.2 fails binding that parameter with an unhandled server error ('Unexpected error in RPC handling', gRPC Unknown) instead of a conversion error; NULL, ordinary values and 2^63-1 (stored as infinity) bind fine."
